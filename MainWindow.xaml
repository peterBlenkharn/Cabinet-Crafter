<Window x:Class="CabinetCrafter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:CabinetCrafter"
        mc:Ignorable="d"
        Title="Cabinet Crafter" Height="820" Width="1280"
        Icon="assets/cabinet-crafter.ico"
        MinHeight="680" MinWidth="980"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="#121214">
    <Grid>
        <wv2:WebView2 Name="webView"
                      Visibility="Hidden"
                      IsHitTestVisible="False"/>
        <Border x:Name="lifecyclePromptOverlay"
                Panel.ZIndex="10"
                Visibility="Collapsed"
                Background="#B8000000">
            <Border Width="520"
                    MaxWidth="720"
                    Margin="24"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FFFDF8"
                    BorderBrush="#222222"
                    BorderThickness="1"
                    AutomationProperties.Name="Unsaved project changes">
                <StackPanel>
                    <TextBlock x:Name="lifecyclePromptTitle"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#181816"
                               Text="Save changes?"/>
                    <TextBlock x:Name="lifecyclePromptMessage"
                               Margin="0,12,0,0"
                               FontSize="14"
                               Foreground="#353532"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="lifecyclePromptDetail"
                               Margin="0,8,0,0"
                               FontSize="12"
                               Foreground="#8C1D1D"
                               TextWrapping="Wrap"
                               Visibility="Collapsed"/>
                    <StackPanel x:Name="lifecyclePromptButtons"
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="lifecyclePromptCancelButton"
                                MinWidth="88"
                                MinHeight="36"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Content="Cancel"
                                Click="LifecyclePromptCancel_Click"/>
                        <Button x:Name="lifecyclePromptDiscardButton"
                                MinWidth="88"
                                MinHeight="36"
                                Margin="0,0,8,0"
                                Padding="12,6"
                                Content="Discard"
                                Click="LifecyclePromptDiscard_Click"/>
                        <Button x:Name="lifecyclePromptSaveButton"
                                MinWidth="88"
                                MinHeight="36"
                                Padding="12,6"
                                FontWeight="SemiBold"
                                Content="Save"
                                Click="LifecyclePromptSave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
        <Border x:Name="startupOverlay"
                Panel.ZIndex="20"
                Background="#F4F4EF"
                AutomationProperties.Name="Cabinet Crafter startup">
            <Grid>
                <Border Width="560"
                        MaxWidth="720"
                        Margin="24"
                        Padding="32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="#FFFDF8"
                        BorderBrush="#242421"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock FontFamily="Consolas"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#6B6B64"
                                   Text="CABINET_CRAFTER"/>
                        <TextBlock x:Name="startupTitle"
                                   Margin="0,12,0,0"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#181816"
                                   Text="Starting Cabinet Crafter"/>
                        <TextBlock x:Name="startupStatus"
                                   Margin="0,12,0,0"
                                   FontSize="14"
                                   Foreground="#353532"
                                   Text="Preparing your design workspace."
                                   TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"/>
                        <ProgressBar x:Name="startupProgress"
                                     Height="5"
                                     Margin="0,24,0,0"
                                     IsIndeterminate="True"
                                     Foreground="#30302C"
                                     Background="#DFDFD7"
                                     AutomationProperties.Name="Starting Cabinet Crafter"/>
                        <StackPanel x:Name="startupErrorActions"
                                    Margin="0,24,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                            <Button x:Name="startupRetryButton"
                                    MinWidth="96"
                                    MinHeight="38"
                                    Padding="14,7"
                                    FontWeight="SemiBold"
                                    Content="Retry"
                                    Click="StartupRetry_Click"/>
                            <Button x:Name="startupCopyDetailsButton"
                                    MinWidth="112"
                                    MinHeight="38"
                                    Margin="8,0,0,0"
                                    Padding="14,7"
                                    Content="Copy details"
                                    Click="StartupCopyDetails_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="startupCopyFeedback"
                                   Margin="0,12,0,0"
                                   FontSize="12"
                                   Foreground="#35603A"
                                   Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
